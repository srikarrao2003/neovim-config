" --- Text-Case Picker via FZF (<space>cc & <space>cr) ---
function! ApplyTextCase(type) abort
  let l:word = expand('<cword>')
  if a:type =~ '^snake_case'
    let l:new = tolower(substitute(l:word, '\(\u\)', '_\l\1', 'g'))
    let l:new = substitute(l:new, '^_', '', '')
  elseif a:type =~ '^UPPER_CASE'
    let l:new = toupper(substitute(l:word, '\(\l\)\(\u\)', '\1_\2', 'g'))
  elseif a:type =~ '^camelCase'
    let l:new = substitute(l:word, '_\(\l\)', '\u\1', 'g')
    let l:new = substitute(l:new, '^\u', '\l&', '')
  elseif a:type =~ '^PascalCase'
    let l:new = substitute(l:word, '\(^\|_\)\(\l\)', '\u\2', 'g')
  elseif a:type =~ '^dash-case'
    let l:new = tolower(substitute(l:word, '_', '-', 'g'))
  else
    return
  endif
  execute 'normal! ciw' . l:new
endfunction

function! TextCaseOpenFzf() abort
  call fzf#run(fzf#wrap({
        \ 'source': ['snake_case', 'camelCase', 'PascalCase', 'UPPER_CASE', 'dash-case'],
        \ 'sink': function('ApplyTextCase'),
        \ 'options': '--prompt="TextCase> " --layout=reverse',
        \ 'window': {'width': 0.35, 'height': 0.3, 'border': 'rounded'}
        \ }))
endfunction
nnoremap <silent> <leader>cc :call TextCaseOpenFzf()<CR>
vnoremap <silent> <leader>cc :call TextCaseOpenFzf()<CR>
nnoremap <silent> <leader>cr :call TextCaseOpenFzf()<CR>

