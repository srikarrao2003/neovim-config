" --- Print & Copy Full File Path (<space>fp) ---
function! PrintAndCopyFilePath() abort
  let l:path = expand('%:p')
  let @" = l:path
  silent! let @+ = l:path
  if exists(':OSCYankRegister')
    silent! execute 'OSCYankRegister "'
  endif
  echohl ModeMsg | echo l:path | echohl None
endfunction
nnoremap <silent> <leader>fp :call PrintAndCopyFilePath()<CR>

" --- Toggle AutoSave (<space>as) ---
let g:auto_save_enabled = 0
function! ToggleAutoSave() abort
  let g:auto_save_enabled = !g:auto_save_enabled
  augroup VimAutoSave
    autocmd!
    if g:auto_save_enabled
      autocmd InsertLeave,TextChanged * silent! if &modifiable && !&readonly && expand('%') != '' | update | endif
    endif
  augroup END
  echo "AutoSave: " . (g:auto_save_enabled ? "ON" : "OFF")
endfunction
nnoremap <silent> <leader>as :call ToggleAutoSave()<CR>

