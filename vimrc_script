" ============================================================================
" 5. HELPER FUNCTIONS (Buffers, Float Terminal, LazyGit)
" ============================================================================
function! CloseOtherBuffers() abort
  let l:current = bufnr('%')
  for l:buf in getbufinfo({'buflisted': 1})
    if l:buf.bufnr != l:current
      execute 'silent! bdelete ' . l:buf.bufnr
    endif
  endfor
  echo "Closed all other buffers"
endfunction

function! ToggleFloatTerm(cmd) abort
  if has('popupwin')
    let buf = term_start(a:cmd, #{hidden: 1, term_finish: 'close'})
    call popup_create(buf, #{minwidth: &columns - 12, minheight: &lines - 6, border: []})
  else
    execute 'term ++curwin ' . a:cmd
  endif
endfunction

